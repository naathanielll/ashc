---
// src/pages/education/masters.astro
import '../../styles/global.css';

const programDetails = [
  "Tuition Costs",
  "Application deadline",
  "Course Work and Structure",
  "Career Paths & more"
];
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Masters in Accounting | Hunter College Accounting Society</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-[#0e0716] text-neutral-100 min-h-screen font-sans antialiased selection:bg-[#FFC72A] selection:text-neutral-950">

    <!-- Top Sticky Header -->
    <header class="border-b border-[#5F259F]/30 bg-[#0e0716]/95 sticky top-0 z-50 backdrop-blur-md px-6 py-4">
      <div class="max-w-5xl mx-auto flex items-center justify-between">
        <a href="/" class="text-sm font-bold text-white hover:text-[#FFC72A] transition flex items-center gap-2">
          <span>← Back to Home</span>
        </a>
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#FFC72A]"></span>
          <span class="text-xs sm:text-sm uppercase tracking-wider text-[#FFC72A] font-bold">
            Masters Program
          </span>
        </div>
      </div>
    </header>

    <main class="max-w-4xl mx-auto px-6 py-12 space-y-10">
      
      <!-- Top Section Title -->
      <div class="text-center space-y-3">
        <h1 class="text-3xl sm:text-5xl font-extrabold text-[#c084fc] tracking-tight">
          Masters In Accounting
        </h1>
        <!-- Top Gold Divider -->
        <div class="w-full h-1 bg-gradient-to-r from-[#FFC72A] via-[#FFD700] to-[#FFC72A] rounded-full mx-auto mt-4"></div>
      </div>

      <!-- Overview Banner Section -->
      <section class="p-8 rounded-3xl bg-[#190e2b]/70 border border-[#5F259F]/40 shadow-xl grid md:grid-cols-3 gap-6 items-center">
        <div class="md:col-span-2 space-y-3">
          <h2 class="text-xl sm:text-2xl font-bold text-white">
            Ready to Take the Next Step and Get Your Master’s?
          </h2>
          <p class="text-sm text-neutral-300 leading-relaxed">
            Whether you’re pursuing your 150-credit requirement for the CPA or simply looking to earn a master’s degree, explore the links below for detailed information about available programs and opportunities!
          </p>
        </div>

        <div class="flex justify-center">
          <div class="w-full h-40 rounded-2xl bg-[#2a1645] border border-[#5F259F]/50 overflow-hidden flex items-center justify-center p-3">
            <img 
              src="/education/masters-finance.jpg" 
              alt="Accounting and Finance" 
              class="w-full h-full object-cover rounded-xl"
              onerror="this.parentElement.innerHTML='<div class=\'text-center text-xs text-neutral-400 p-4\'>📊<br><span class=\'text-[#FFC72A] font-semibold\'>150-Credit CPA Pathway</span><br>Financial Analysis & Reporting</div>'"
            />
          </div>
        </div>
      </section>

      <!-- Program Info & Application Links Section -->
      <section class="p-8 rounded-3xl bg-[#190e2b]/70 border border-[#5F259F]/40 shadow-xl grid md:grid-cols-2 gap-8 items-center">
        
        <!-- CPA Illustration Box -->
        <div class="flex justify-center items-center">
          <div class="w-full max-w-sm p-6 rounded-2xl bg-neutral-100 border border-[#5F259F]/40 text-neutral-900 shadow-md flex flex-col items-center justify-center min-h-[220px]">
            <img 
              src="/education/cpa-diagram.png" 
              alt="CPA Diagram" 
              class="max-h-48 object-contain"
              onerror="this.parentElement.innerHTML='<div class=\'flex items-center gap-4 text-center font-bold\'><div class=\'w-20 h-20 rounded-full border-4 border-red-600 flex items-center justify-center text-red-600 text-xl\'>CPA</div><div class=\'text-left space-y-1 text-sm text-neutral-800\'><div>➔ Certified</div><div>➔ Public</div><div>➔ Accountant</div></div></div>'"
            />
          </div>
        </div>

        <!-- Links & Info Column -->
        <div class="space-y-6">
          
          <!-- Information List -->
          <div class="space-y-2">
            <h3 class="text-base font-bold text-white">
              Information on the program:
            </h3>
            <ul class="list-disc list-inside space-y-1 text-xs sm:text-sm text-neutral-300">
              {programDetails.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>

          <!-- Overview Button -->
          <div>
            <a 
              href="https://www.hunter.cuny.edu/students/admissions/graduate-admissions/school-of-arts-and-sciences/social-sciences/ms-in-accounting/" 
              target="_blank" 
              rel="noopener noreferrer"
              class="block w-full text-center px-6 py-3 rounded-xl bg-[#5F259F] hover:bg-[#7329c2] text-white text-xs sm:text-sm font-bold transition shadow-lg shadow-[#5F259F]/30"
            >
              Hunter College MS in Accounting
            </a>
          </div>

          <!-- Application Button Group -->
          <div class="space-y-2 pt-2 border-t border-[#5F259F]/30">
            <h3 class="text-base font-bold text-white">
              Application Link:
            </h3>
            <a 
              href="https://www.hunter.cuny.edu/students/admissions/graduate-admissions/apply/graduate-degree/" 
              target="_blank" 
              rel="noopener noreferrer"
              class="block w-full text-center px-6 py-3 rounded-xl bg-[#5F259F] hover:bg-[#7329c2] text-white text-xs sm:text-sm font-bold transition shadow-lg shadow-[#5F259F]/30"
            >
              Application For The Graduate Program
            </a>
          </div>

        </div>

      </section>

      <!-- Advisor Contact Footer Section -->
      <section class="pt-4 space-y-6">
        <div class="p-6 rounded-2xl bg-[#190e2b]/50 border border-[#5F259F]/40 text-center">
          <p class="text-xs sm:text-sm text-neutral-200">
            For Questions Email Professor Yuan (Judy) Yin: 
            <a 
              href="mailto:yuan.yin@hunter.cuny.edu" 
              class="text-[#FFC72A] font-semibold underline hover:text-[#ffe07b] transition ml-1 inline-block"
            >
              yuan.yin@hunter.cuny.edu
            </a>
          </p>
        </div>

        <!-- Bottom Gold Divider -->
        <div class="w-full h-1 bg-gradient-to-r from-[#FFC72A] via-[#FFD700] to-[#FFC72A] rounded-full"></div>
      </section>

    </main>

    <!-- Footer -->
    <footer class="border-t border-[#5F259F]/20 py-8 px-6 text-center text-xs text-neutral-400 mt-12">
      <p>© {new Date().getFullYear()} Hunter College Accounting Society • Graduate Resources</p>
    </footer>

  </body>
</html>
