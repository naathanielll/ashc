---
// src/pages/education/cpa-requirements.astro
import '../../styles/global.css';
import cpaData from '../../data/cpa-requirements.json';
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CPA Requirements | Hunter College Accounting Society</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-[#0e0716] text-neutral-100 min-h-screen font-sans antialiased selection:bg-[#FFC72A] selection:text-neutral-950 flex flex-col justify-between">

    <!-- Top Sticky Header -->
    <header class="border-b border-[#5F259F]/30 bg-[#0e0716]/95 sticky top-0 z-50 backdrop-blur-md px-6 py-4">
      <div class="max-w-4xl mx-auto flex items-center justify-between">
        <a href="/" class="text-sm font-bold text-white hover:text-[#FFC72A] transition flex items-center gap-2">
          <span>← Back to Home</span>
        </a>
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#FFC72A]"></span>
          <span class="text-xs sm:text-sm uppercase tracking-wider text-[#FFC72A] font-bold">
            Education Guide
          </span>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-4xl mx-auto px-6 py-12 space-y-10 w-full flex-1">
      
      <!-- Page Hero -->
      <section class="space-y-4">
        <span class="inline-block px-3 py-1 text-xs font-semibold uppercase tracking-wider text-[#FFC72A] bg-[#5F259F]/30 border border-[#FFC72A]/40 rounded-full">
          {cpaData.badge}
        </span>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight">
          {cpaData.title}
        </h1>
        <p class="text-base sm:text-lg text-neutral-300 max-w-2xl leading-relaxed">
          {cpaData.description}
        </p>
      </section>

      <!-- Gold Accent Divider -->
      <div class="w-full h-1 bg-gradient-to-r from-[#FFC72A] via-[#FFD700] to-[#FFC72A] rounded-full"></div>

      <!-- Information Cards Grid / Stack -->
      <section class="space-y-6">
        {cpaData.sections.map((section) => (
          <div class="p-6 sm:p-8 rounded-3xl bg-[#190e2b]/70 border border-[#5F259F]/40 shadow-xl space-y-4">
            <div class="flex items-center justify-between border-b border-[#5F259F]/30 pb-3">
              <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
                {section.title}
              </h2>
              <span class="px-3 py-1 rounded-full text-xs font-bold bg-[#5F259F]/40 border border-[#FFC72A]/40 text-[#FFC72A]">
                {section.credits}
              </span>
            </div>

            <ul class="list-disc list-inside text-sm sm:text-base text-neutral-300 space-y-2 pl-2">
              {section.requirements.map((req) => (
                <li class="leading-relaxed">{req}</li>
              ))}
            </ul>
          </div>
        ))}
      </section>

      <!-- Help / Advising Link -->
      <section class="p-6 rounded-2xl bg-[#190e2b]/50 border border-[#5F259F]/30 text-center space-y-2">
        <p class="text-xs sm:text-sm text-neutral-300">
          Need help planning out your course schedule to meet CPA eligibility? 
          <a href="/education/faculty" class="text-[#FFC72A] font-semibold underline hover:text-[#ffe07b] transition ml-1">
            Contact an accounting advisor
          </a>.
        </p>
      </section>

    </main>

    <!-- Footer -->
    <footer class="border-t border-[#5F259F]/20 py-8 px-6 text-center text-xs text-neutral-400 mt-12">
      <p>© {new Date().getFullYear()} Hunter College Accounting Society • Education Resources</p>
    </footer>

  </body>
</html>
