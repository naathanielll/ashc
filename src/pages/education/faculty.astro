---
// src/pages/education/faculty.astro
import '../../styles/global.css';
import advisingData from '../../data/faculty.json';
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Advisor + Faculty Directory | Hunter College Accounting Society</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-[#0e0716] text-neutral-100 min-h-screen font-sans antialiased selection:bg-[#FFC72A] selection:text-neutral-950">

    <!-- Top Sticky Navigation Header -->
    <header class="border-b border-[#5F259F]/30 bg-[#0e0716]/95 sticky top-0 z-50 backdrop-blur-md px-6 py-4">
      <div class="max-w-6xl mx-auto flex items-center justify-between">
        <a href="/" class="text-sm font-bold text-white hover:text-[#FFC72A] transition flex items-center gap-2">
          <span>← Back to Home</span>
        </a>
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#FFC72A]"></span>
          <span class="text-xs sm:text-sm uppercase tracking-wider text-[#FFC72A] font-bold">
            Advising & Faculty
          </span>
        </div>
      </div>
    </header>

    <main class="max-w-6xl mx-auto px-6 py-12 space-y-12">
      
      <!-- Page Title -->
      <div class="text-center space-y-3">
        <h1 class="text-3xl sm:text-5xl font-extrabold text-[#c084fc] tracking-tight">
          Advising
        </h1>
        <div class="w-full h-1 bg-gradient-to-r from-[#FFC72A] via-[#FFD700] to-[#FFC72A] rounded-full mx-auto mt-4"></div>
      </div>

      <!-- Undergraduate Accounting Advisor Section -->
      <section class="p-8 rounded-3xl bg-[#190e2b]/80 border border-[#5F259F]/50 shadow-2xl grid md:grid-cols-12 gap-8 items-center">
        
        <!-- ASHC Pennant / Banner Graphic -->
        <div class="md:col-span-4 flex justify-center">
          <div class="relative w-36 sm:w-44 bg-gradient-to-b from-[#5F259F] to-[#36115e] border-2 border-[#FFC72A] text-center py-8 px-4 rounded-t-md shadow-2xl [clip-path:polygon(0%_0%,100%_0%,100%_82%,50%_100%,0%_82%)]">
            <div class="space-y-4 text-white font-black text-2xl sm:text-3xl tracking-widest drop-shadow-md">
              <div>A</div>
              <div>S</div>
              <div>H</div>
              <div>C</div>
            </div>
          </div>
        </div>

        <!-- Advising Details -->
        <div class="md:col-span-8 space-y-6">
          <h2 class="text-2xl font-bold text-[#c084fc] underline underline-offset-4">
            {advisingData.undergradAdvisor.title}
          </h2>
          <p class="text-sm font-semibold text-white">
            There are two options for advising:
          </p>

          <div class="space-y-4 text-sm text-neutral-300">
            <!-- Option 1: Navigate -->
            <div class="space-y-1">
              <p class="font-bold text-[#FFC72A]">• By Navigate Appointment:</p>
              <p class="pl-4">
                Visit <a href={advisingData.undergradAdvisor.navigateUrl} target="_blank" rel="noopener noreferrer" class="text-white font-semibold underline hover:text-[#FFC72A] transition">Navigate</a> to see availability and schedule an appointment.
              </p>
            </div>

            <!-- Option 2: Email -->
            <div class="space-y-2">
              <p class="font-bold text-[#FFC72A]">• By Email:</p>
              <p class="pl-4 text-xs font-semibold text-neutral-200">Instructions for email advising:</p>
              <ul class="list-disc list-inside pl-6 space-y-1.5 text-xs sm:text-sm text-neutral-300">
                <li>
                  Email correspondence should be sent to: 
                  <a href={`mailto:${advisingData.undergradAdvisor.email}`} class="text-[#FFC72A] underline font-medium ml-1">
                    {advisingData.undergradAdvisor.email}
                  </a>
                </li>
                <li>Please include your <strong>Hunter ID #</strong> in the subject line of all emails.</li>
                <li>Please state the reason you need help from an advisor; include a screenshot of any error messages to help explain your issue.</li>
                <li>Advising emails are answered by <strong>{advisingData.undergradAdvisor.advisorName}</strong>.</li>
                <li>
                  For discussing class options, please see requirements in 
                  <a href={advisingData.undergradAdvisor.degreeWorksUrl} target="_blank" rel="noopener noreferrer" class="text-white underline hover:text-[#FFC72A]">
                    DegreeWorks
                  </a> 
                  before making an appointment or emailing.
                </li>
              </ul>
            </div>
          </div>
        </div>

      </section>

      <!-- Bottom Layout: Faculty Directory (Left) & Other Advising (Right) -->
      <div class="grid lg:grid-cols-12 gap-8 items-start">
        
        <!-- Faculty Directory (Left 7 Cols) -->
        <section class="lg:col-span-7 p-6 sm:p-8 rounded-3xl bg-[#190e2b]/60 border border-[#5F259F]/40 shadow-xl space-y-6">
          <div class="border-b border-[#5F259F]/30 pb-3 flex items-center justify-between">
            <h2 class="text-xl sm:text-2xl font-bold text-[#c084fc]">
              Faculty Directory
            </h2>
            <span class="text-xs text-neutral-400 font-semibold uppercase tracking-wider">Accounting</span>
          </div>

          <div class="divide-y divide-[#5F259F]/20 text-xs sm:text-sm">
            {advisingData.faculty.map((member) => (
              <div class="py-2.5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1">
                <span class="font-semibold text-white">{member.name}:</span>
                <div class="flex flex-wrap gap-1 text-xs">
                  {member.emails.map((email, idx) => (
                    <span>
                      <a href={`mailto:${email}`} class="text-[#FFC72A] hover:underline font-medium">
                        {email}
                      </a>
                      {idx < member.emails.length - 1 && <span class="text-neutral-400 mx-1">OR</span>}
                    </span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- Other Advising Branches (Right 5 Cols) -->
        <div class="lg:col-span-5 space-y-6">
          
          <!-- Graduate Accounting Advisor -->
          <section class="p-6 rounded-2xl bg-[#190e2b]/60 border border-[#5F259F]/40 shadow-lg space-y-3">
            <h3 class="text-lg font-bold text-[#c084fc] underline underline-offset-4">
              {advisingData.otherAdvising.graduateAdvisor.title}
            </h3>
            <p class="text-xs sm:text-sm text-neutral-300 leading-relaxed">
              Advising is done by contacting <strong>{advisingData.otherAdvising.graduateAdvisor.name}</strong> at 
              <a href={`mailto:${advisingData.otherAdvising.graduateAdvisor.email}`} class="text-[#FFC72A] font-semibold underline hover:text-[#ffe07b] ml-1">
                {advisingData.otherAdvising.graduateAdvisor.email}
              </a>
            </p>
          </section>

          <!-- Career Development Advising -->
          <section class="p-6 rounded-2xl bg-[#190e2b]/60 border border-[#5F259F]/40 shadow-lg space-y-3">
            <h3 class="text-lg font-bold text-[#c084fc] underline underline-offset-4">
              {advisingData.otherAdvising.careerDevelopment.title}
            </h3>
            <p class="text-xs sm:text-sm text-neutral-300 leading-relaxed">
              Contact the 
              <a 
                href={advisingData.otherAdvising.careerDevelopment.url} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="text-[#FFC72A] font-semibold underline hover:text-[#ffe07b]"
              >
                {advisingData.otherAdvising.careerDevelopment.office}
              </a> 
              to make an appointment.
            </p>
          </section>

          <!-- General Education Requirements Advising -->
          <section class="p-6 rounded-2xl bg-[#190e2b]/60 border border-[#5F259F]/40 shadow-lg space-y-3">
            <h3 class="text-lg font-bold text-[#c084fc] underline underline-offset-4">
              {advisingData.otherAdvising.generalEducation.title}
            </h3>
            <p class="text-xs sm:text-sm text-neutral-300 leading-relaxed">
              Make an appointment with your assigned advisor through the following 
              <a 
                href={advisingData.otherAdvising.generalEducation.url} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="text-[#FFC72A] font-semibold underline hover:text-[#ffe07b]"
              >
                Navigate link
              </a>.
            </p>
          </section>

        </div>

      </div>

      <!-- Bottom Accent Bar -->
      <div class="w-full h-1 bg-gradient-to-r from-[#FFC72A] via-[#FFD700] to-[#FFC72A] rounded-full"></div>

    </main>

    <!-- Footer -->
    <footer class="border-t border-[#5F259F]/20 py-8 px-6 text-center text-xs text-neutral-400 mt-12">
      <p>© {new Date().getFullYear()} Hunter College Accounting Society • Faculty & Advising</p>
    </footer>

  </body>
</html>
