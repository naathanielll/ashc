---
// src/pages/education/major-requirements.astro
import '../../styles/global.css';

const professionalStudies = [
  { code: "ACC 10100", title: "Accounting: The Language of Business", credits: "3 cr" },
  { code: "ACC 27100", title: "Accounting 1", credits: "3 cr" },
  { code: "ACC 27200", title: "Accounting II", credits: "3 cr" },
  { code: "ACCP 37100", title: "Intermediate Accounting I", credits: "3 cr" },
  { code: "ACCP 37200", title: "Intermediate Accounting 2", credits: "4 cr" },
  { code: "ACCP 37300", title: "Federal Income Taxation", credits: "3 cr" },
  { code: "ACCP 37400", title: "Managerial Accounting (Cost Accounting)", credits: "3 cr" },
  { code: "ACCP 47000", title: "Advanced Accounting", credits: "4 cr" },
  { code: "ACCP 47500", title: "Auditing", credits: "4 cr" }
];

const otherProfessional = [
  { code: "ACC 28000", title: "Business Law I", credits: "3 cr" },
  { code: "ECO 10000", title: "Introduction to Economics", credits: "3 cr" },
  { code: "ECO 20000", title: "Principles of Microeconomics", credits: "3 cr" },
  { code: "ECO 20100", title: "Principles of Macroeconomics", credits: "3 cr" },
  { code: "ECO 36500", title: "Corporate Finance", credits: "3 cr" },
  { code: "ACCP 36700", title: "Analysis of Financial Statements", credits: "3 cr" },
  { code: "ACCP 47600", title: "Computer Accounting Systems", credits: "3 cr" },
  { 
    code: "ECO 22100 or STAT 21300", 
    title: "Economic Statistics OR Intro to Applied Statistics", 
    credits: "3 cr" 
  }
];
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Major Requirements | Hunter College Accounting Society</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-[#0e0716] text-neutral-100 min-h-screen font-sans antialiased selection:bg-[#FFC72A] selection:text-neutral-950">

    <!-- Top Sticky Header with Clear "Major Requirements" Label -->
    <header class="border-b border-[#5F259F]/30 bg-[#0e0716]/95 sticky top-0 z-50 backdrop-blur-md px-6 py-4">
      <div class="max-w-5xl mx-auto flex items-center justify-between">
        <a href="/" class="text-sm font-bold text-white hover:text-[#FFC72A] transition flex items-center gap-2">
          <span>← Back to Home</span>
        </a>
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#FFC72A]"></span>
          <span class="text-xs sm:text-sm uppercase tracking-wider text-[#FFC72A] font-bold">
            Major Requirements
          </span>
        </div>
      </div>
    </header>

    <main class="max-w-4xl mx-auto px-6 py-16 space-y-16">
      
      <!-- Page Hero Header -->
      <section class="space-y-4">
        <span class="inline-block px-3 py-1 text-xs font-semibold uppercase tracking-wider text-[#FFC72A] bg-[#5F259F]/30 border border-[#FFC72A]/40 rounded-full">
          BS – Bachelor of Science • Current Curriculum (60–73 Credits)
        </span>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight">
          Accounting Undergraduate Major Requirements
        </h1>
        <p class="text-lg text-neutral-300 max-w-2xl leading-relaxed">
          Official course sequence and degree requirements for students pursuing the Bachelor of Science in Accounting at Hunter College.
        </p>
      </section>

      <!-- Section: Math Sequence -->
      <section class="p-8 rounded-3xl bg-[#190e2b]/60 border border-[#5F259F]/40 shadow-xl space-y-6">
        <div class="flex items-center justify-between border-b border-[#5F259F]/30 pb-3">
          <h2 class="text-2xl font-bold text-white tracking-tight">Math Sequence</h2>
          <span class="text-xs text-[#FFC72A] font-semibold uppercase tracking-wider">Foundation</span>
        </div>

        <!-- 3 Credit Requirement -->
        <div class="space-y-3">
          <h3 class="text-sm font-bold uppercase tracking-wider text-[#FFC72A]">
            Earn at least 3 credits from the following:
          </h3>
          <div class="p-4 rounded-xl bg-[#0e0716]/70 border border-[#5F259F]/30 space-y-1 text-sm text-neutral-200">
            <p>• <strong>MATH 15000</strong> - Calculus I (4 cr)</p>
            <p class="text-xs text-neutral-400 pl-3">AND / OR</p>
            <p>• <strong>MATH 15200</strong> - Calculus for the Life and Social Sciences (4 cr)</p>
          </div>
        </div>

        <!-- 9 Credit Requirement -->
        <div class="space-y-3">
          <h3 class="text-sm font-bold uppercase tracking-wider text-[#FFC72A]">
            Earn at least 9 credits from the following:
          </h3>
          <div class="grid sm:grid-cols-2 gap-3">
            <div class="p-3.5 rounded-xl bg-[#0e0716]/70 border border-[#5F259F]/30 text-xs text-neutral-300">
              <strong class="text-white block text-sm mb-1">Algebra</strong>
              MATH 10100 - Algebra for College Students (3 cr)<br/>
              <span class="text-neutral-400">OR</span> MATH 101EN - Enhanced (3 cr)
            </div>
            <div class="p-3.5 rounded-xl bg-[#0e0716]/70 border border-[#5F259F]/30 text-xs text-neutral-300">
              <strong class="text-white block text-sm mb-1">Elementary Math</strong>
              MATH 10500 - Math for Elementary Education 2 (3 cr)
            </div>
            <div class="p-3.5 rounded-xl bg-[#0e0716]/70 border border-[#5F259F]/30 text-xs text-neutral-300">
              <strong class="text-white block text-sm mb-1">Precalculus</strong>
              MATH 12400 - College Algebra & Trig (4 cr)<br/>
              <span class="text-neutral-400">OR</span> MATH 12500 - Precalculus (4 cr)<br/>
              <span class="text-neutral-400">OR</span> MATH 12550 - Precalculus with Workshop (4 cr)
            </div>
            <div class="p-3.5 rounded-xl bg-[#0e0716]/70 border border-[#5F259F]/30 text-xs text-neutral-300">
              <strong class="text-white block text-sm mb-1">Workshop</strong>
              MATH 14000 - Mathematical Reasoning Workshop (1 cr)
            </div>
          </div>
        </div>

        <!-- Placement Note -->
        <div class="p-4 rounded-xl bg-[#5F259F]/20 border border-[#5F259F]/40 text-xs text-neutral-300 leading-relaxed space-y-1">
          <p>
            <strong>Notes:</strong> Students may place out of any of the classes listed above and MATH 15000 (STEM) / MATH 15200 (STEM) without replacing the credits.
          </p>
          <p class="text-[#FFC72A]">
            * MATH 15000 (STEM) is preferred for students who will take additional MATH courses.
          </p>
        </div>
      </section>

      <!-- Section: Professional Studies (30 Credits Required) -->
      <section class="space-y-6">
        <div class="flex items-center justify-between border-b border-[#5F259F]/30 pb-3">
          <div>
            <h2 class="text-2xl font-bold text-white tracking-tight">Professional Studies</h2>
            <p class="text-xs text-neutral-400 mt-1">Core Accounting Sequence</p>
          </div>
          <span class="px-3 py-1 rounded-full text-xs font-bold bg-[#FFC72A] text-neutral-950">
            30 Credits (Required)
          </span>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3.5">
          {professionalStudies.map((course) => (
            <div class="p-4 rounded-2xl bg-[#190e2b]/50 border border-[#5F259F]/30 hover:border-[#FFC72A]/40 transition flex flex-col justify-between">
              <div>
                <span class="text-xs font-bold text-[#FFC72A] tracking-wide uppercase">{course.code}</span>
                <h3 class="text-sm font-semibold text-white mt-1 leading-snug">{course.title}</h3>
              </div>
              <span class="text-[11px] font-medium text-neutral-400 mt-3">{course.credits}</span>
            </div>
          ))}
        </div>

        <!-- Academic Policy Callout -->
        <div class="p-6 rounded-2xl bg-red-950/20 border border-red-500/30 text-xs text-neutral-300 leading-relaxed space-y-2">
          <div class="flex items-center gap-2 text-red-400 font-bold uppercase tracking-wider text-[11px]">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <span>Course Repeat & Dismissal Policy</span>
          </div>
          <p>
            Students who receive a grade of <strong>“D” or lower</strong> in any of the nine required Accounting courses in the Professional Studies Requirement will be allowed to repeat the course <strong>only once</strong>.
          </p>
          <p>
            In total, students may repeat <strong>no more than three</strong> Accounting courses for which they received a grade of “D” or lower. Students who exceed this allowed number of course repeats will be dismissed from the B.S. program in Accounting. The Academic Advisor for the B.S. program in Accounting may, under extraordinary circumstances, make exceptions to this rule.
          </p>
        </div>
      </section>

      <!-- Section: Other Professional Requirements (30 Credits) -->
      <section class="space-y-6">
        <div class="flex items-center justify-between border-b border-[#5F259F]/30 pb-3">
          <div>
            <h2 class="text-2xl font-bold text-white tracking-tight">Other Professional Requirements</h2>
            <p class="text-xs text-neutral-400 mt-1">Economics, Law, Statistics & Systems</p>
          </div>
          <span class="px-3 py-1 rounded-full text-xs font-bold bg-[#FFC72A] text-neutral-950">
            30 Credits
          </span>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3.5">
          {otherProfessional.map((course) => (
            <div class="p-4 rounded-2xl bg-[#190e2b]/50 border border-[#5F259F]/30 hover:border-[#FFC72A]/40 transition flex flex-col justify-between">
              <div>
                <span class="text-xs font-bold text-[#FFC72A] tracking-wide uppercase">{course.code}</span>
                <h3 class="text-sm font-semibold text-white mt-1 leading-snug">{course.title}</h3>
              </div>
              <span class="text-[11px] font-medium text-neutral-400 mt-3">{course.credits}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- Bottom Advisor Contact Notice -->
      <section class="pt-6">
        <!-- Gold Accent Line -->
        <div class="w-full h-1 bg-gradient-to-r from-[#FFC72A] via-[#FFD700] to-[#FFC72A] rounded-full mb-6"></div>
        
        <div class="p-6 rounded-2xl bg-[#190e2b]/70 border border-[#5F259F]/40 text-center">
          <p class="text-sm sm:text-base text-neutral-200">
            For any questions regarding degree requirements please contact our accounting advisor Joseph Downey: 
            <a 
              href="mailto:accugrad@hunter.cuny.edu" 
              class="text-[#FFC72A] font-bold underline hover:text-[#ffe07b] transition ml-1 inline-block"
            >
              accugrad@hunter.cuny.edu
            </a>
          </p>
        </div>
      </section>

    </main>

    <!-- Footer -->
    <footer class="border-t border-[#5F259F]/20 py-8 px-6 text-center text-xs text-neutral-400">
      <p>© {new Date().getFullYear()} Hunter College Accounting Society • Academic Resources</p>
    </footer>

  </body>
</html>
