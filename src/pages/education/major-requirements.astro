---
// src/pages/education/major-requirements.astro
import '../../styles/global.css';

const professionalStudies = [
  { code: "ACC 10100", title: "Accounting: The Language of Business", credits: "3 cr" },
  { code: "ACC 27100", title: "Accounting 1", credits: "3 cr" },
  { code: "ACC 27200", title: "Accounting II", credits: "3 cr" },
  { code: "ACCP 37100", title: "Intermediate Accounting I", credits: "3 cr" },
  { code: "ACCP 37200", title: "Intermediate Accounting 2", credits: "4 cr" },
  { code: "ACCP 37300", title: "Federal Income Taxation", credits: "3 cr" },
  { code: "ACCP 37400", title: "Managerial Accounting (Cost Accounting)", credits: "3 cr" },
  { code: "ACCP 47000", title: "Advanced Accounting", credits: "4 cr" },
  { code: "ACCP 47500", title: "Auditing", credits: "4 cr" }
];

const otherProfessional = [
  { code: "ACC 28000", title: "Business Law I", credits: "3 cr" },
  { code: "ECO 10000", title: "Introduction to Economics", credits: "3 cr" },
  { code: "ECO 20000", title: "Principles of Microeconomics", credits: "3 cr" },
  { code: "ECO 20100", title: "Principles of Macroeconomics", credits: "3 cr" },
  { code: "ECO 36500", title: "Corporate Finance", credits: "3 cr" },
  { code: "ACCP 36700", title: "Analysis of Financial Statements", credits: "3 cr" },
  { code: "ACCP 47600", title: "Computer Accounting Systems", credits: "3 cr" },
  { code: "ECO 22100 or STAT 21300", title: "Economic Statistics OR Intro to Applied Statistics", credits: "3 cr" }
];
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Major Requirements | Hunter College Accounting Society</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-[#0e0716] text-neutral-100 min-h-screen font-sans antialiased selection:bg-[#FFC72A] selection:text-neutral-950">

    <!-- Top Navigation Header -->
    <header class="border-b border-[#5F259F]/30 bg-[#0e0716]/95 sticky top-0 z-50 backdrop-blur-md px-6 py-4">
      <div class="max-w-5xl mx-auto flex items-center justify-between">
        <a href="/" class="text-sm font-bold text-white hover:text-[#FFC72A] transition flex items-center gap-2">
          <span>← Back to Home</span>
        </a>
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#FFC72A]"></span>
          <span class="text-xs sm:text-sm uppercase tracking-wider text-[#FFC72A] font-bold">
            Major Requirements
          </span>
        </div>
      </div>
    </header>

    <main class="max-w-4xl mx-auto px-6 py-12 space-y-12">
      
      <!-- Top Section Header -->
      <div class="text-center space-y-2">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-[#c084fc] tracking-tight">
          Major Requirements
        </h1>
      </div>

      <!-- Main Degree Card -->
      <section class="p-8 sm:p-10 rounded-3xl bg-[#190e2b]/80 border border-[#5F259F]/50 shadow-2xl space-y-10">
        
        <!-- Degree Header Titles -->
        <div class="text-center space-y-1">
          <h2 class="text-xl sm:text-2xl font-black uppercase tracking-tight text-white underline underline-offset-4">
            ACCOUNTING UNDERGRADUATE DEGREE
          </h2>
          <h3 class="text-lg sm:text-xl font-bold uppercase tracking-tight text-neutral-100 underline underline-offset-4">
            BS - BACHELOR OF SCIENCE
          </h3>
          <p class="text-sm font-medium text-neutral-300 pt-1">
            Current Curriculum (60-73)
          </p>
        </div>

        <!-- Math Sequence -->
        <div class="space-y-6 text-sm text-neutral-200">
          <div class="border-b border-[#5F259F]/40 pb-2">
            <h4 class="text-base font-bold text-white underline underline-offset-2">
              Math Sequence
            </h4>
          </div>

          <div class="space-y-2">
            <p class="font-semibold text-white">Earn at least 3 credits from the following:</p>
            <ul class="list-disc list-inside pl-2 space-y-1 text-neutral-300">
              <li>
                <strong>MATH 15000</strong> - Calculus I (4 cr)
                <span class="block pl-6 text-xs text-[#FFC72A] font-semibold">AND MATH 15200 - Calculus for the Life and Social Science (4 cr)</span>
              </li>
            </ul>
          </div>

          <div class="space-y-2">
            <p class="font-semibold text-white">Earn at least 9 credits from the following:</p>
            <ul class="list-disc list-inside pl-2 space-y-2 text-neutral-300">
              <li>
                <strong>MATH 10100</strong> - Algebra for College Students (3 cr)
                <span class="block pl-6 text-xs text-neutral-400"><strong>OR</strong> MATH 101EN - Algebra College Stud-Enhanced (3 cr)</span>
              </li>
              <li><strong>MATH 10500</strong> - Math for Elementary Education 2 (3 cr)</li>
              <li>
                <strong>MATH 12400</strong> - College Algebra and Trigonometry (4 cr)
                <span class="block pl-6 text-xs text-neutral-400"><strong>OR</strong> MATH 12500 - Precalculus (4 cr)</span>
                <span class="block pl-6 text-xs text-neutral-400"><strong>OR</strong> MATH 12550 - Precalculus with Workshop (4 cr)</span>
              </li>
              <li><strong>MATH 14000</strong> - Mathematical Reasoning Workshop (1 cr)</li>
            </ul>
          </div>

          <div class="p-4 rounded-xl bg-[#0e0716]/60 border border-[#5F259F]/30 text-xs text-neutral-300 leading-relaxed space-y-1.5">
            <p>
              <strong>Notes:</strong> Students may place out of any of the classes listed above and MATH 15000 (STEM)/MATH 15200 (STEM) without replacing the credits.
            </p>
            <p class="text-[#FFC72A]">
              MATH 15000 (STEM) is preferred for students who will take additional MATH courses.
            </p>
          </div>
        </div>

        <!-- Professional Studies (Required) 30 Credits -->
        <div class="space-y-4 text-sm text-neutral-200">
          <div class="border-b border-[#5F259F]/40 pb-2">
            <h4 class="text-base font-bold text-white">
              <span class="underline underline-offset-2">Professional Studies</span> <span class="text-red-400 font-bold">(required)</span> 30 credits
            </h4>
          </div>

          <ul class="list-disc list-inside pl-2 space-y-1 text-neutral-300">
            {professionalStudies.map((course) => (
              <li>
                <strong>{course.code}</strong> - {course.title} ({course.credits})
              </li>
            ))}
          </ul>

          <!-- Exception Policy Notice -->
          <div class="p-4 rounded-xl bg-red-950/20 border border-red-500/30 text-xs text-neutral-300 leading-relaxed mt-4 space-y-2">
            <p>
              Students who receive a grade of <strong>“D” or lower</strong> in any of the nine required Accounting courses in the Professional Studies Requirement will be allowed to repeat the course <strong>only once</strong>. In total, students may repeat no more than three Accounting courses for which they received a grade of “D” or lower. Students who exceed this allowed number of course repeats will be dismissed from the B.S. program in Accounting.
            </p>
            <p class="font-medium text-neutral-200">
              The Academic Advisor for the B.S. program in Accounting may, under extraordinary circumstances, make exceptions to this rule.
            </p>
          </div>
        </div>

        <!-- Other Professional Requirements 30 Credits -->
        <div class="space-y-4 text-sm text-neutral-200">
          <div class="border-b border-[#5F259F]/40 pb-2">
            <h4 class="text-base font-bold text-white underline underline-offset-2">
              Other Professional Requirements 30 credits
            </h4>
          </div>

          <ul class="list-disc list-inside pl-2 space-y-1 text-neutral-300">
            {otherProfessional.map((course) => (
              <li>
                <strong>{course.code}</strong> - {course.title} ({course.credits})
              </li>
            ))}
          </ul>
        </div>

      </section>

      <!-- External Information Link Section -->
      <section class="text-center space-y-4 py-4">
        <p class="text-sm font-semibold text-neutral-200">
          Please click on the following link if you would like more information on the requirements.
        </p>
        <div>
          <a 
            href="https://hunter-undergraduate.catalog.cuny.edu/programs/ACCP-BS" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-block px-8 py-2.5 rounded-lg bg-[#5F259F] hover:bg-[#752dc4] text-white text-xs font-bold uppercase tracking-wider transition shadow-lg shadow-[#5F259F]/20"
          >
            information
          </a>
        </div>
      </section>

      <!-- Advisor Contact Footer Section -->
      <section class="pt-4">
        <!-- Gold Divider Bar -->
        <div class="w-full h-1 bg-[#FFC72A] rounded-full mb-6"></div>

        <p class="text-center text-xs sm:text-sm text-neutral-200">
          For any questions regarding degree requirements please contact our accounting advisor Joseph Downey: 
          <a 
            href="mailto:accugrad@hunter.cuny.edu" 
            class="text-[#FFC72A] font-semibold underline hover:text-[#ffe07b] transition ml-1"
          >
            accugrad@hunter.cuny.edu
          </a>.
        </p>
      </section>

    </main>

    <!-- Footer -->
    <footer class="border-t border-[#5F259F]/20 py-8 px-6 text-center text-xs text-neutral-400 mt-12">
      <p>© {new Date().getFullYear()} Hunter College Accounting Society • Academic Resources</p>
    </footer>

  </body>
</html>
