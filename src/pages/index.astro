---
import '../styles/global.css';

const announcements = [
  {
    date: "Upcoming • Sep 9",
    title: "Club Fair",
    details: "Learn more about ASHC!"
  },
  {
    date: "Upcoming • Sep 23",
    title: "Executive Board Meet & Greet",
    details: "Come and meet your fellow E-board members! Feel free to network with all your peers too."
  }
];

const officers = [
  {
    name: "Jackie Lai",
    role: "President",
    photo: "jackie.jpg",
    bio: "Manages club operations, leads general body meetings, and coordinates campus relations."
  },
  {
    name: "Blaze",
    role: "Vice President",
    photo: "blaze.jpg",
    bio: "Oversees internal events, budgeting, and semester project workshops."
  }
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hunter College Accounting Society</title>
  </head>
  <body class="bg-[#0e0716] text-neutral-100 min-h-screen px-6 py-16 font-sans antialiased">
    <div class="max-w-3xl mx-auto space-y-16">
      
      <!-- Club Header -->
      <header class="space-y-4">
        <span class="inline-block px-3 py-1 text-xs font-semibold uppercase tracking-wider text-[#FFC72A] bg-[#5F259F]/30 border border-[#FFC72A]/40 rounded-full">
          Hunter College
        </span>
        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-white">Accounting Society</h1>
        <p class="text-lg text-neutral-300 max-w-xl leading-relaxed">
          We bring students together for weekly workshops, professional development, and community projects.
        </p>
        <div class="flex flex-wrap gap-3 pt-2">
          <a href="https://forms.google.com" target="_blank" class="px-5 py-2.5 rounded-xl bg-[#FFC72A] text-neutral-950 font-bold hover:bg-[#e6b224] transition text-sm shadow-lg shadow-[#FFC72A]/10">
            Join the Club
          </a>
          <a href="#announcements" class="px-5 py-2.5 rounded-xl bg-[#1a0f2b] border border-[#5F259F]/40 text-purple-100 font-semibold hover:border-[#FFC72A]/50 hover:bg-[#23143a] transition text-sm">
            Upcoming Events
          </a>
        </div>
      </header>

      <!-- Announcements Section -->
      <section id="announcements" class="space-y-6">
        <h2 class="text-2xl font-bold tracking-tight text-white">Announcements & Updates</h2>
        <div class="space-y-4">
          {announcements.map((item) => (
            <div class="p-6 rounded-2xl bg-[#190e2b]/60 border border-[#5F259F]/30 hover:border-purple-600/40 transition space-y-2">
              <span class="text-xs font-semibold text-[#FFC72A] tracking-wide uppercase">{item.date}</span>
              <h3 class="text-lg font-bold text-white">{item.title}</h3>
              <p class="text-sm text-neutral-300 leading-relaxed">{item.details}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Officer Roster -->
      <section class="space-y-6">
        <h2 class="text-2xl font-bold tracking-tight text-white">Executive Board</h2>
        <div class="grid sm:grid-cols-2 gap-4">
          {officers.map((officer) => (
            <div class="p-5 rounded-2xl bg-[#190e2b]/60 border border-[#5F259F]/30 hover:border-[#FFC72A]/50 transition flex flex-col items-start">
              <img 
                src={officer.photo} 
                alt={officer.name} 
                class="w-16 h-16 rounded-full object-cover border-2 border-[#5F259F] mb-4 bg-[#281344]"
                onerror="this.src='https://via.placeholder.com/150'"
              />
              <h3 class="font-bold text-lg text-white">{officer.name}</h3>
              <span class="text-xs font-medium text-[#FFC72A] mt-0.5">{officer.role}</span>
              <p class="text-sm text-neutral-300 mt-3 leading-relaxed">{officer.bio}</p>
            </div>
          ))}
        </div>
      </section>

    </div>
  </body>
</html>
