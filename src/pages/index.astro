---
import '../styles/global.css';

const announcements = [
  {
    date: "Upcoming • Sep 9",
    title: "Club Fair",
    details: "Learn more about ASHC!"
  },
  {
    date: "Upcoming • Sep 23",
    title: "Executive Board Meet & Greet",
    details: "Come and meet your fellow E-board members! Feel free to network with all your peers too."
  }
];

const officers = [
  {
    name: "Jackie Lai",
    role: "President",
    photo: "jackie.jpg",
    bio: "Manages club operations, leads general body meetings, and coordinates campus relations."
  },
  {
    name: "Blaze",
    role: "Vice President",
    photo: "blaze.jpg",
    bio: "Oversees internal events, budgeting, and semester project workshops."
  }
];
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Accounting Society | Hunter College</title>
  </head>
  <body class="bg-[#0e0716] text-neutral-100 min-h-screen font-sans antialiased selection:bg-[#FFC72A] selection:text-neutral-950">

    <!-- Sticky Header Navigation -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-[#0e0716]/90 border-b border-[#5F259F]/30">
      <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
        
        <!-- Brand / Crest -->
        <a href="/" class="flex items-center gap-3 group">
          <img 
            src="/logo.png" 
            alt="Hunter Accounting Logo" 
            class="w-9 h-9 rounded-xl object-contain bg-[#190e2b] border border-[#5F259F] p-1"
            onerror="this.style.display='none'"
          />
          <div class="flex flex-col">
            <span class="font-bold text-white text-sm tracking-tight group-hover:text-[#FFC72A] transition">Accounting Society</span>
            <span class="text-[10px] text-neutral-400 font-medium tracking-wider uppercase">Hunter College</span>
          </div>
        </a>

        <!-- Desktop Navigation Menu -->
        <nav class="hidden lg:flex items-center gap-1 text-sm font-medium text-neutral-300">
          <a href="/" class="px-3 py-2 rounded-lg hover:text-[#FFC72A] hover:bg-[#190e2b] transition">
            Home
          </a>

          <!-- VITA Dropdown -->
          <div class="relative group py-2">
            <button class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg hover:text-[#FFC72A] hover:bg-[#190e2b] transition">
              <span>VITA</span>
              <svg class="w-3.5 h-3.5 text-neutral-400 group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="absolute left-0 top-full pt-1 hidden group-hover:block w-56 z-50">
              <div class="rounded-xl bg-[#190e2b] border border-[#5F259F]/50 shadow-2xl p-1.5 space-y-0.5">
                <a href="/vita" class="block px-3 py-2 rounded-lg text-xs hover:bg-[#5F259F]/40 hover:text-white transition">
                  Program Overview
                </a>
                <a href="/vita#volunteer" class="block px-3 py-2 rounded-lg text-xs hover:bg-[#5F259F]/40 hover:text-white transition">
                  Volunteer Opportunities
                </a>
                <a href="/vita#client-tax" class="block px-3 py-2 rounded-lg text-xs hover:bg-[#5F259F]/40 hover:text-white transition">
                  Tax Prep Appointments
                </a>
               <a href="/vita#client-tax" class="block px-3 py-2 rounded-lg text-xs hover:bg-[#5F259F]/40 hover:text-white transition">
                  VITA E-Board
                </a>
              </div>
            </div>
          </div>

          <!-- Events Dropdown -->
          <div class="relative group py-2">
            <button class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg hover:text-[#FFC72A] hover:bg-[#190e2b] transition">
              <span>Events</span>
              <svg class="w-3.5 h-3.5 text-neutral-400 group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="absolute left-0 top-full pt-1 hidden group-hover:block w-48 z-50">
              <div class="rounded-xl bg-[#190e2b] border border-[#5F259F]/50 shadow-2xl p-1.5 space-y-0.5">
                <a href="#announcements" class="block px-3 py-2 rounded-lg text-xs hover:bg-[#5F259F]/40 hover:text-white transition">
                  Upcoming Events
                </a>
              </div>
            </div>
          </div>

          <!-- Education Dropdown (Hunter Purple Submenu) -->
          <div class="relative group py-2">
            <button class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg hover:text-[#FFC72A] hover:bg-[#190e2b] transition">
              <span>Education</span>
              <svg class="w-3.5 h-3.5 text-neutral-400 group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="absolute left-0 top-full pt-1 hidden group-hover:block w-60 z-50">
              <div class="rounded-xl bg-[#5F259F] border border-[#FFC72A]/40 shadow-2xl p-2 space-y-1">
                <a href="/education/cpa-requirements" class="block px-3 py-2 rounded-lg text-xs font-semibold text-purple-100 hover:bg-[#190e2b] hover:text-[#FFC72A] transition">
                  CPA Requirements
                </a>
                <a href="/education/major-requirements" class="block px-3 py-2 rounded-lg text-xs font-semibold text-purple-100 hover:bg-[#190e2b] hover:text-[#FFC72A] transition">
                  Major Requirements
                </a>
                <a href="/education/masters" class="block px-3 py-2 rounded-lg text-xs font-semibold text-purple-100 hover:bg-[#190e2b] hover:text-[#FFC72A] transition">
                  Masters In Accounting
                </a>
                <a href="/education/faculty" class="block px-3 py-2 rounded-lg text-xs font-semibold text-purple-100 hover:bg-[#190e2b] hover:text-[#FFC72A] transition">
                  Advisor + Faculty
                </a>
              </div>
            </div>
          </div>

          <a href="#resources" class="px-3 py-2 rounded-lg hover:text-[#FFC72A] hover:bg-[#190e2b] transition">
            Useful Links
          </a>
          <a href="#contact" class="px-3 py-2 rounded-lg hover:text-[#FFC72A] hover:bg-[#190e2b] transition">
            Contact us
          </a>
        </nav>

        <!-- Header Action Button -->
        <a 
          href="https://docs.google.com/forms/d/e/1FAIpQLSeUEKzWtcRuj5kBHhk-J9ckwZqmzKj_OCR24RObOFJT5PO_IQ/viewform" 
          target="_blank" 
          class="px-4 py-2 text-xs font-bold rounded-xl bg-[#FFC72A] text-neutral-950 hover:bg-[#e6b224] transition shadow-md shadow-[#FFC72A]/10"
        >
          Join Society
        </a>
      </div>
    </header>

    <!-- Page Content Container -->
    <main class="max-w-4xl mx-auto px-6 py-16 space-y-20">
      
      <!-- Club Hero Section -->
      <section class="space-y-6">
        <span class="inline-block px-3 py-1 text-xs font-semibold uppercase tracking-wider text-[#FFC72A] bg-[#5F259F]/30 border border-[#FFC72A]/40 rounded-full">
          Hunter College • Department of Economics & Accounting
        </span>
        <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white leading-tight">
          Accounting Society
        </h1>
        <p class="text-lg text-neutral-300 max-w-2xl leading-relaxed">
          Empowering Hunter students with technical workshops, CPA guidance, VITA tax preparation, and direct recruiting pipelines into public and private accounting.
        </p>
        <div class="flex flex-wrap gap-3 pt-2">
          <a 
            href="https://forms.google.com" 
            target="_blank" 
            class="px-6 py-3 rounded-xl bg-[#FFC72A] text-neutral-950 font-bold hover:bg-[#e6b224] transition text-sm shadow-lg shadow-[#FFC72A]/10"
          >
            Become a Member
          </a>
          <a 
            href="#announcements" 
            class="px-6 py-3 rounded-xl bg-[#190e2b] border border-[#5F259F]/50 text-purple-100 font-semibold hover:border-[#FFC72A]/50 hover:bg-[#23143a] transition text-sm"
          >
            Upcoming Events
          </a>
        </div>
      </section>

      <!-- Announcements Section -->
      <section id="announcements" class="space-y-6">
        <div class="flex items-center justify-between border-b border-[#5F259F]/30 pb-3">
          <h2 class="text-2xl font-bold tracking-tight text-white">Announcements & Events</h2>
          <span class="text-xs text-[#FFC72A] font-semibold uppercase tracking-wider">Fall 2026 Semester</span>
        </div>
        <div class="space-y-4">
          {announcements.map((item) => (
            <div class="p-6 rounded-2xl bg-[#190e2b]/60 border border-[#5F259F]/30 hover:border-[#FFC72A]/40 transition space-y-2">
              <span class="text-xs font-semibold text-[#FFC72A] tracking-wide uppercase">{item.date}</span>
              <h3 class="text-lg font-bold text-white">{item.title}</h3>
              <p class="text-sm text-neutral-300 leading-relaxed">{item.details}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Executive Board Section -->
      <section id="officers" class="space-y-6">
        <div class="flex items-center justify-between border-b border-[#5F259F]/30 pb-3">
          <h2 class="text-2xl font-bold tracking-tight text-white">Executive Board</h2>
          <span class="text-xs text-neutral-400">2026 – 2027 Officers</span>
        </div>
        <div class="grid sm:grid-cols-2 gap-4">
          {officers.map((officer) => (
            <div class="p-5 rounded-2xl bg-[#190e2b]/60 border border-[#5F259F]/30 hover:border-[#FFC72A]/50 transition flex flex-col items-start">
              <img 
                src={officer.photo} 
                alt={officer.name} 
                class="w-16 h-16 rounded-full object-cover border-2 border-[#5F259F] mb-4 bg-[#281344]"
                onerror="this.src='https://via.placeholder.com/150'"
              />
              <h3 class="font-bold text-lg text-white">{officer.name}</h3>
              <span class="text-xs font-medium text-[#FFC72A] mt-0.5">{officer.role}</span>
              <p class="text-sm text-neutral-300 mt-3 leading-relaxed">{officer.bio}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Useful Links & Resources Section -->
      <section id="resources" class="space-y-6">
        <h2 class="text-2xl font-bold tracking-tight text-white border-b border-[#5F259F]/30 pb-3">Useful Links</h2>
        <div class="grid sm:grid-cols-3 gap-4">
          <a href="https://hunter.cuny.edu" target="_blank" class="p-5 rounded-2xl bg-[#190e2b]/40 border border-[#5F259F]/30 hover:border-[#FFC72A]/50 transition block">
            <h3 class="text-base font-bold text-white mb-1">Hunter Catalog</h3>
            <p class="text-xs text-neutral-400">Official Hunter degree roadmaps and prerequisites.</p>
          </a>
          <a href="https://www.nasba.org" target="_blank" class="p-5 rounded-2xl bg-[#190e2b]/40 border border-[#5F259F]/30 hover:border-[#FFC72A]/50 transition block">
            <h3 class="text-base font-bold text-white mb-1">NASBA Portal</h3>
            <p class="text-xs text-neutral-400">New York State CPA exam credit requirements and licensing.</p>
          </a>
          <a href="https://www.irs.gov/individuals/free-tax-return-preparation-for-qualifying-taxpayers" target="_blank" class="p-5 rounded-2xl bg-[#190e2b]/40 border border-[#5F259F]/30 hover:border-[#FFC72A]/50 transition block">
            <h3 class="text-base font-bold text-white mb-1">IRS VITA Program</h3>
            <p class="text-xs text-neutral-400">Federal guidelines and client qualification thresholds.</p>
          </a>
        </div>
      </section>

      <!-- Contact Section -->
      <section id="contact" class="p-8 rounded-3xl bg-gradient-to-br from-[#190e2b] to-[#0e0716] border border-[#5F259F]/40 space-y-4">
        <h2 class="text-2xl font-bold text-white">Get in Touch</h2>
        <p class="text-neutral-300 text-sm max-w-xl">
          Have questions about society events, corporate sponsorships, or becoming a VITA volunteer? Reach out directly to our e-board.
        </p>
        <div class="flex flex-wrap gap-4 pt-2">
          <a href="mailto:accountingsocietyhc@gmail.com" class="px-5 py-2.5 rounded-xl bg-[#5F259F] hover:bg-[#722cbd] text-white text-xs font-bold transition">
            Email E-Board
          </a>
          <a href="https://www.instagram.com/accountingsocietyhc/" target="_blank" class="px-5 py-2.5 rounded-xl bg-[#5F259F] hover:bg-[#722cbd] text-white text-xs font-bold transition">
            Instagram
          </a>
          <a href="https://www.linkedin.com/company/accounting-society-of-hunter-college/" target="_blank" class="px-5 py-2.5 rounded-xl bg-[#5F259F] hover:bg-[#722cbd] text-white text-xs font-bold transition">
            LinkedIn
          </a>
        </div>
      </section>

    </main>

    <!-- Footer -->
    <footer class="border-t border-[#5F259F]/20 py-8 px-6 text-center text-xs text-neutral-400">
      <p>© {new Date().getFullYear()} Hunter College Accounting Society. All rights reserved.</p>
    </footer>

  </body>
</html>
