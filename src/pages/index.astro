---
import '../styles/global.css';

const announcements = [
  {
    date: "Upcoming • Oct 15",
    title: "Fall Speaker Panel & Networking",
    details: "Campus Center Rm 204 at 6:00 PM. Food and drinks provided."
  },
  {
    date: "Past • Sep 28",
    title: "General Body Meeting & Project Pitches",
    details: "Introduced semester goals and formed working committees."
  }
];

const officers = [
  {
    name: "Jackie Lai",
    role: "President",
    photo: "jackie.jpg",
    bio: "Manages club operations, leads general body meetings, and coordinates campus relations."
  },
  {
    name: "Blaze",
    role: "Vice President",
    photo: "blaze.jpg",
    bio: "Oversees internal events, budgeting, and semester project workshops."
  }
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Professional Club</title>
  </head>
  <body class="bg-neutral-950 text-neutral-100 min-h-screen px-6 py-16 font-sans antialiased">
    <div class="max-w-3xl mx-auto space-y-16">
      
      <!-- Club Header -->
      <header class="space-y-4">
        <span class="inline-block px-3 py-1 text-xs font-semibold uppercase tracking-wider text-emerald-400 bg-emerald-950/60 border border-emerald-800/50 rounded-full">
          Hunter College
        </span>
        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight">Accounting Society</h1>
        <p class="text-lg text-neutral-400 max-w-xl">
          We bring students together for weekly workshops, professional development, and community projects.
        </p>
        <div class="flex flex-wrap gap-3 pt-2">
          <a href="https://forms.google.com" target="_blank" class="px-5 py-2.5 rounded-xl bg-white text-neutral-950 font-semibold hover:bg-neutral-200 transition text-sm">
            Join the Club
          </a>
          <a href="#announcements" class="px-5 py-2.5 rounded-xl bg-neutral-900 border border-neutral-800 text-neutral-300 font-semibold hover:bg-neutral-800 transition text-sm">
            Upcoming Events
          </a>
        </div>
      </header>

      <!-- Announcements Section -->
      <section id="announcements" class="space-y-6">
        <h2 class="text-2xl font-bold tracking-tight">Announcements & Updates</h2>
        <div class="space-y-4">
          {announcements.map((item) => (
            <div class="p-6 rounded-2xl bg-neutral-900/70 border border-neutral-800 space-y-2">
              <span class="text-xs font-medium text-emerald-400 tracking-wide uppercase">{item.date}</span>
              <h3 class="text-lg font-bold">{item.title}</h3>
              <p class="text-sm text-neutral-400 leading-relaxed">{item.details}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Officer Roster -->
      <section class="space-y-6">
        <h2 class="text-2xl font-bold tracking-tight">Executive Board</h2>
        <div class="grid sm:grid-cols-2 gap-4">
          {officers.map((officer) => (
            <div class="p-5 rounded-2xl bg-neutral-900/70 border border-neutral-800 hover:border-neutral-700 transition flex flex-col items-start">
              <img 
                src={officer.photo} 
                alt={officer.name} 
                class="w-16 h-16 rounded-full object-cover border border-neutral-700 mb-4 bg-neutral-800"
                onerror="this.src='https://via.placeholder.com/150'"
              />
              <h3 class="font-bold text-lg">{officer.name}</h3>
              <span class="text-xs font-medium text-neutral-400 mt-0.5">{officer.role}</span>
              <p class="text-sm text-neutral-400 mt-3 leading-relaxed">{officer.bio}</p>
            </div>
          ))}
        </div>
      </section>

    </div>
  </body>
</html>
