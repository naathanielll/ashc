---
// src/pages/vita/eboard.astro
import '../../styles/global.css';
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>VITA E-Board | Hunter College Accounting Society</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-[#0e0716] text-neutral-100 min-h-screen font-sans antialiased selection:bg-[#FFC72A] selection:text-neutral-950 flex flex-col justify-between">

    <!-- Top Sticky Header -->
    <header class="border-b border-[#5F259F]/30 bg-[#0e0716]/95 sticky top-0 z-50 backdrop-blur-md px-6 py-4">
      <div class="max-w-5xl mx-auto flex items-center justify-between">
        <a href="/" class="text-sm font-bold text-white hover:text-[#FFC72A] transition flex items-center gap-2">
          <span>← Back to Home</span>
        </a>
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#FFC72A] animate-pulse"></span>
          <span class="text-xs sm:text-sm uppercase tracking-wider text-[#FFC72A] font-bold">
            VITA Leadership
          </span>
        </div>
      </div>
    </header>

    <!-- Main Content Container -->
    <main class="max-w-3xl mx-auto px-6 py-20 flex-1 flex flex-col justify-center items-center text-center space-y-8">
      
      <!-- Status Badge -->
      <span class="inline-block px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-[#FFC72A] bg-[#5F259F]/40 border border-[#FFC72A]/40 rounded-full">
        2026 – 2027 Season
      </span>

      <!-- Title & Headline -->
      <div class="space-y-4">
        <h1 class="text-4xl sm:text-6xl font-black text-[#c084fc] tracking-tight">
          Coming Soon
        </h1>
        <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
          VITA Executive Board Directory
        </h2>
        <p class="text-neutral-300 text-sm sm:text-base max-w-xl mx-auto leading-relaxed">
          The new Volunteer Income Tax Assistance leadership roster is currently being finalized for the upcoming tax season. Profiles and contact details will be posted shortly.
        </p>
      </div>

      <!-- Accent Divider Line -->
      <div class="w-48 h-1 bg-gradient-to-r from-[#FFC72A] via-[#FFD700] to-[#FFC72A] rounded-full"></div>

      <!-- Informational Card with Email Underneath -->
      <div class="w-full max-w-lg p-6 sm:p-8 rounded-3xl bg-[#190e2b]/70 border border-[#5F259F]/40 shadow-xl space-y-5">
        <p class="text-xs sm:text-sm text-neutral-300 leading-relaxed">
          Interested in learning more about the program or getting certified to join the team?
        </p>
        
        <div>
          <a 
            href="/vita/program-overview" 
            class="inline-block px-6 py-2.5 rounded-xl bg-[#5F259F] hover:bg-[#7329c2] text-white text-xs font-bold transition shadow-md shadow-[#5F259F]/20"
          >
            Program Overview
          </a>
        </div>

        <!-- Styled Email Display -->
        <div class="pt-3 border-t border-[#5F259F]/30 flex flex-col items-center gap-1.5">
          <span class="text-xs text-neutral-400">Questions or inquiries? Reach out to:</span>
          <a 
            href="mailto:huntercollegevita@gmail.com" 
            class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[#0e0716]/60 border border-[#5F259F]/40 text-sm font-semibold text-[#FFC72A] hover:border-[#FFC72A]/60 hover:text-white transition group"
          >
            <svg class="w-4 h-4 text-[#FFC72A] group-hover:text-white transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            huntercollegevita@gmail.com
          </a>
        </div>
      </div>

    </main>

    <!-- Footer -->
    <footer class="border-t border-[#5F259F]/20 py-8 px-6 text-center text-xs text-neutral-400">
      <p>© {new Date().getFullYear()} Hunter College Accounting Society • VITA Program</p>
    </footer>

  </body>
</html>
