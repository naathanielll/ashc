---
// src/pages/vita/client-tax.astro
import '../../styles/global.css';
import taxpayerInfo from '../../data/taxpayer-info.json';
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Information for Taxpayers | Hunter College Accounting Society</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-[#0e0716] text-neutral-100 min-h-screen font-sans antialiased selection:bg-[#FFC72A] selection:text-neutral-950">

    <!-- Top Sticky Header -->
    <header class="border-b border-[#5F259F]/30 bg-[#0e0716]/95 sticky top-0 z-50 backdrop-blur-md px-6 py-4">
      <div class="max-w-5xl mx-auto flex items-center justify-between">
        <a href="/" class="text-sm font-bold text-white hover:text-[#FFC72A] transition flex items-center gap-2">
          <span>← Back to Home</span>
        </a>
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#FFC72A]"></span>
          <span class="text-xs sm:text-sm uppercase tracking-wider text-[#FFC72A] font-bold">
            Taxpayer Resources
          </span>
        </div>
      </div>
    </header>

    <main class="max-w-4xl mx-auto px-6 py-12 space-y-12">
      
      <!-- Page Title -->
      <div class="text-center space-y-3">
        <h1 class="text-3xl sm:text-5xl font-extrabold text-[#c084fc] tracking-tight">
          Information For Taxpayers
        </h1>
        <div class="w-full h-1 bg-gradient-to-r from-[#FFC72A] via-[#FFD700] to-[#FFC72A] rounded-full mx-auto mt-4"></div>
      </div>

      <!-- Closed Notice Banner -->
      <section class="p-6 sm:p-8 rounded-3xl bg-[#190e2b]/90 border border-[#5F259F]/50 shadow-2xl text-center space-y-2">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
          {taxpayerInfo.statusBanner}
        </h2>
      </section>

      <!-- Upcoming Season Information & Eligibility Card -->
      <section class="p-8 sm:p-10 rounded-3xl bg-[#190e2b]/70 border border-[#5F259F]/40 shadow-xl space-y-8 text-center">
        
        <!-- Upcoming Details -->
        <div class="space-y-3">
          <h3 class="text-xl sm:text-2xl font-bold text-white underline underline-offset-4">
            {taxpayerInfo.upcomingSeason.title}
          </h3>
          {taxpayerInfo.upcomingSeason.messages.map((message) => (
            <p class="text-sm sm:text-base text-neutral-300">
              {message}
            </p>
          ))}
        </div>

        <!-- Qualification Check -->
        <div class="space-y-4 pt-4 border-t border-[#5F259F]/30">
          <h3 class="text-lg sm:text-xl font-bold text-white underline underline-offset-4">
            {taxpayerInfo.qualification.prompt}
          </h3>
          <div>
            <a 
              href={taxpayerInfo.qualification.url} 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-block px-8 py-3 rounded-xl bg-[#5F259F] hover:bg-[#7329c2] text-[#FFC72A] text-sm font-bold underline transition shadow-lg shadow-[#5F259F]/30"
            >
              {taxpayerInfo.qualification.buttonText}
            </a>
          </div>
        </div>

      </section>

      <!-- Gold Accent Divider -->
      <div class="w-full h-1 bg-gradient-to-r from-[#FFC72A] via-[#FFD700] to-[#FFC72A] rounded-full"></div>

      <!-- Additional Information Section -->
      <section class="p-8 sm:p-10 rounded-3xl bg-[#190e2b]/70 border border-[#5F259F]/40 shadow-xl space-y-8 text-center">
        
        <h2 class="text-2xl sm:text-3xl font-bold text-white underline underline-offset-4">
          Additional Information
        </h2>

        <!-- Refund Status Inquiries -->
        <div class="space-y-3">
          <h3 class="text-lg sm:text-xl font-bold text-white">
            {taxpayerInfo.additionalInformation.refundSection.title}
          </h3>
          <div class="space-y-2 text-sm sm:text-base text-neutral-300">
            <p>
              Check the status of your federal refund 
              <a 
                href={taxpayerInfo.additionalInformation.refundSection.federalRefundUrl} 
                target="_blank" 
                rel="noopener noreferrer"
                class="text-[#FFC72A] font-bold underline hover:text-[#ffe07b] transition ml-1"
              >
                here
              </a>
            </p>
            <p>
              Check the status of your NY State refund 
              <a 
                href={taxpayerInfo.additionalInformation.refundSection.stateRefundUrl} 
                target="_blank" 
                rel="noopener noreferrer"
                class="text-[#FFC72A] font-bold underline hover:text-[#ffe07b] transition ml-1"
              >
                here
              </a>
            </p>
          </div>
        </div>

        <!-- Documentation & Transcripts -->
        <div class="space-y-3 pt-6 border-t border-[#5F259F]/30">
          <h3 class="text-lg sm:text-xl font-bold text-white">
            {taxpayerInfo.additionalInformation.transcriptSection.title}
          </h3>
          <p class="text-sm sm:text-base text-neutral-300">
            Request your transcript 
            <a 
              href={taxpayerInfo.additionalInformation.transcriptSection.transcriptUrl} 
              target="_blank" 
              rel="noopener noreferrer"
              class="text-[#FFC72A] font-bold underline hover:text-[#ffe07b] transition ml-1"
            >
              here
            </a>
          </p>
        </div>

      </section>

      <!-- Questions Footer Banner -->
      <section class="p-6 rounded-2xl bg-[#190e2b]/50 border border-[#5F259F]/30 text-center space-y-2">
        <p class="text-xs sm:text-sm text-neutral-300">
          For any additional tax assistance inquiries, reach out to 
          <a href={`mailto:${taxpayerInfo.contactEmail}`} class="text-[#FFC72A] font-semibold hover:underline ml-1">
            {taxpayerInfo.contactEmail}
          </a>
        </p>
      </section>

    </main>

    <!-- Footer -->
    <footer class="border-t border-[#5F259F]/20 py-8 px-6 text-center text-xs text-neutral-400 mt-12">
      <p>© {new Date().getFullYear()} Hunter College Accounting Society • VITA Taxpayer Services</p>
    </footer>

  </body>
</html>
