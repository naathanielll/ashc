---
import '../../styles/global.css';

const irsResources = [
  {
    title: "Link & Learn Taxes Certification Portal",
    code: "VITA / TCE LMS",
    desc: "The official testing portal where volunteers create an account and complete all required certification exams.",
    url: "https://lms.linklearncertification.com/lms/signin"
  },
  {
    title: "VITA/TCE Volunteer Resource Guide",
    code: "IRS Publication 4012",
    desc: "The primary reference manual used by volunteers during tax preparation to check filing thresholds, dependents, and deductions.",
    url: "https://www.irs.gov/pub/irs-pdf/p4012.pdf"
  },
  {
    title: "VITA/TCE Training Guide",
    code: "IRS Publication 4491",
    desc: "Comprehensive training manual covering basic, advanced, and specialty tax law concepts.",
    url: "https://www.irs.gov/pub/irs-pdf/p4491.pdf"
  },
  {
    title: "Volunteer Standards of Conduct Training",
    code: "IRS Publication 4961",
    desc: "Mandatory ethics course and guidelines for taxpayer confidentiality and conflict of interest.",
    url: "https://www.irs.gov/pub/irs-pdf/p4961.pdf"
  },
  {
    title: "Intake/Interview & Quality Review Training",
    code: "IRS Publication 5101",
    desc: "Procedures for taxpayer intake, verifying government IDs, and conducting second-party reviews.",
    url: "https://www.irs.gov/pub/irs-pdf/p5101.pdf"
  }
];
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>VITA Program Overview | Hunter College Accounting Society</title>
  </head>
  <body class="bg-[#0e0716] text-neutral-100 min-h-screen font-sans antialiased selection:bg-[#FFC72A] selection:text-neutral-950">

    <!-- Top Navigation Bar -->
    <header class="border-b border-[#5F259F]/30 bg-[#0e0716]/90 sticky top-0 z-50 backdrop-blur-md px-6 py-4">
      <div class="max-w-5xl mx-auto flex items-center justify-between">
        <a href="/" class="text-sm font-bold text-white hover:text-[#FFC72A] transition flex items-center gap-2">
          <span>← Back to Home</span>
        </a>
        <span class="text-xs uppercase tracking-wider text-[#FFC72A] font-semibold">VITA Program</span>
      </div>
    </header>

    <main class="max-w-4xl mx-auto px-6 py-16 space-y-16">
      
      <!-- Page Hero Header -->
      <section class="space-y-4">
        <span class="inline-block px-3 py-1 text-xs font-semibold uppercase tracking-wider text-[#FFC72A] bg-[#5F259F]/30 border border-[#FFC72A]/40 rounded-full">
          IRS Volunteer Income Tax Assistance
        </span>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight">
          VITA Program Overview
        </h1>
        <p class="text-lg text-neutral-300 max-w-2xl leading-relaxed">
          The Hunter College VITA program prepares students to become IRS-certified tax preparers, providing free, quality tax preparation services to eligible community members.
        </p>
      </section>

      <!-- Section: Updates from VITA Team -->
      <section class="p-8 rounded-3xl bg-[#190e2b]/80 border border-[#5F259F]/50 shadow-xl space-y-6">
        <div class="flex items-center gap-3">
          <div class="w-3 h-3 rounded-full bg-[#FFC72A]"></div>
          <h2 class="text-2xl font-bold text-white">Want updates from the VITA team?</h2>
        </div>

        <p class="text-neutral-300 text-sm leading-relaxed">
          To receive announcements, interest meeting schedules, and onboarding packets, send an email to:
        </p>

        <div class="p-4 rounded-2xl bg-[#0e0716] border border-[#5F259F]/40 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div class="space-y-1">
            <span class="text-xs text-neutral-400 font-medium">Official VITA Contact</span>
            <div class="text-base font-bold text-[#FFC72A]">huntercollegevita@gmail.com</div>
          </div>
        </div>

        <div class="space-y-2 pt-2">
          <p class="text-xs font-semibold uppercase tracking-wider text-purple-200">Please format your email with the following details:</p>
          <ul class="space-y-2 text-sm text-neutral-300">
            <li class="flex items-start gap-2.5">
              <span class="text-[#FFC72A] font-bold">•</span>
              <span><strong class="text-white">Subject line:</strong> "VITA Interest 2026"</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-[#FFC72A] font-bold">•</span>
              <span><strong class="text-white">Full Name:</strong> Include your first and last name</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-[#FFC72A] font-bold">•</span>
              <span><strong class="text-white">Participation status:</strong> Specify if you are a <em>new VITA participant</em> or <em>returning VITA participant</em></span>
            </li>
          </ul>
        </div>
      </section>

      <!-- Section: Requirements to Become a Volunteer -->
      <section class="space-y-8">
        <div>
          <h2 class="text-2xl font-bold text-white tracking-tight">Requirements to Become a Volunteer</h2>
          <p class="text-sm text-neutral-300 mt-2">
            All prospective volunteers must complete their testing through the IRS certification portal:
          </p>
          <div class="mt-3">
            <a 
              href="https://lms.linklearncertification.com/lms/signin" 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-xs font-semibold text-[#FFC72A] hover:underline bg-[#190e2b] px-3.5 py-2 rounded-xl border border-[#5F259F]/40"
            >
              <span>Access IRS Link & Learn Portal (lms.linklearncertification.com)</span>
              <span>↗</span>
            </a>
          </div>
        </div>

        <!-- Required Exams Breakdown -->
        <div class="p-6 rounded-2xl bg-[#190e2b]/50 border border-[#5F259F]/40 space-y-4">
          <h3 class="text-base font-bold text-[#FFC72A] uppercase tracking-wider">Required Exams</h3>
          
          <div class="space-y-3">
            <div class="p-4 rounded-xl bg-[#0e0716]/80 border border-purple-900/30">
              <h4 class="font-bold text-white text-sm">For All Volunteers (Mandatory)</h4>
              <ul class="list-disc list-inside text-sm text-neutral-300 mt-2 space-y-1">
                <li>Volunteer Standards of Conduct Exam</li>
                <li>Intake/Interview and Quality Review Exam</li>
              </ul>
            </div>

            <div class="p-4 rounded-xl bg-[#0e0716]/80 border border-purple-900/30">
              <h4 class="font-bold text-white text-sm">Preparer Track Exams (Role Dependent)</h4>
              <ul class="list-disc list-inside text-sm text-neutral-300 mt-2 space-y-1">
                <li><strong class="text-white">Basic Exam Certification:</strong> Required for Basic Preparers</li>
                <li><strong class="text-white">Advanced Exam Certification:</strong> Required for Advanced Preparers, Officers, and Site Coordinators</li>
                <li><strong class="text-white">Site Coordinator Exam Certification:</strong> Required for Site Coordinators</li>
              </ul>
            </div>
          </div>

          <!-- Minimum Score Callout -->
          <div class="p-4 rounded-xl bg-amber-500/10 border border-[#FFC72A]/40 text-center">
            <p class="text-sm text-neutral-200">
              <strong class="text-[#FFC72A] font-bold">MUST</strong> score a minimum of <strong class="text-[#FFC72A] font-bold">80%</strong> for all exams.
            </p>
          </div>
        </div>

        <!-- Timeline & Training Notes -->
        <div class="grid sm:grid-cols-2 gap-4">
          <div class="p-5 rounded-2xl bg-[#190e2b]/40 border border-[#5F259F]/30 space-y-2">
            <span class="text-xs text-[#FFC72A] font-semibold uppercase">Fall Semester</span>
            <h4 class="font-bold text-white text-base">Interest Meeting</h4>
            <p class="text-xs text-neutral-300 leading-relaxed">
              There will be an official interest meeting for VITA held at the end of the fall semester to review timeline expectations and registration.
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-[#190e2b]/40 border border-[#5F259F]/30 space-y-2">
            <span class="text-xs text-[#FFC72A] font-semibold uppercase">January Winter Intersession</span>
            <h4 class="font-bold text-white text-base">Mandatory Software Training</h4>
            <p class="text-xs text-neutral-300 leading-relaxed">
              Mandatory lecture and software training sessions will be held in January for all candidates who have passed the required certification exams.
            </p>
          </div>
        </div>
      </section>

      <!-- Section: Official IRS Publications -->
      <section class="space-y-6">
        <div class="border-b border-[#5F259F]/30 pb-3 flex items-center justify-between">
          <h2 class="text-2xl font-bold text-white tracking-tight">Official IRS Training Materials</h2>
          <span class="text-xs text-neutral-400">PDF Publications</span>
        </div>
        
        <div class="grid sm:grid-cols-2 gap-4">
          {irsResources.map((res) => (
            <a 
              href={res.url} 
              target="_blank" 
              rel="noopener noreferrer"
              class="p-5 rounded-2xl bg-[#190e2b]/50 border border-[#5F259F]/30 hover:border-[#FFC72A]/50 transition block group space-y-2"
            >
              <div class="flex items-center justify-between">
                <span class="text-[11px] font-bold uppercase tracking-wider text-[#FFC72A] bg-[#5F259F]/40 px-2 py-0.5 rounded-md">
                  {res.code}
                </span>
                <span class="text-xs text-neutral-400 group-hover:text-white transition">PDF ↗</span>
              </div>
              <h3 class="font-bold text-white text-sm group-hover:text-[#FFC72A] transition pt-1">
                {res.title}
              </h3>
              <p class="text-xs text-neutral-400 leading-relaxed">
                {res.desc}
              </p>
            </a>
          ))}
        </div>
      </section>

      <!-- Questions Banner -->
      <section class="p-6 rounded-2xl bg-[#190e2b]/60 border border-[#5F259F]/30 text-center space-y-3">
        <p class="text-sm text-neutral-300">
          If you have any further questions please email:
        </p>
        <a 
          href="mailto:huntercollegevita@gmail.com" 
          class="inline-block text-base font-bold text-[#FFC72A] hover:underline"
        >
          huntercollegevita@gmail.com
        </a>
      </section>

    </main>

    <!-- Footer -->
    <footer class="border-t border-[#5F259F]/20 py-8 px-6 text-center text-xs text-neutral-400">
      <p>© {new Date().getFullYear()} Hunter College Accounting Society • VITA Program</p>
    </footer>

  </body>
</html>
