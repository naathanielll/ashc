

---
import '../../styles/global.css';
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>VITA Program | Hunter College Accounting Society</title>
  </head>
  <body class="bg-[#0e0716] text-neutral-100 min-h-screen font-sans antialiased selection:bg-[#FFC72A] selection:text-neutral-950">

    <header class="border-b border-[#5F259F]/30 bg-[#0e0716]/90 sticky top-0 z-50 backdrop-blur-md px-6 py-4">
      <div class="max-w-5xl mx-auto flex items-center justify-between">
        <a href="/" class="text-sm font-bold text-white hover:text-[#FFC72A] transition flex items-center gap-2">
          <span>← Back to Home</span>
        </a>
        <span class="text-xs uppercase tracking-wider text-[#FFC72A] font-semibold">IRS VITA Program</span>
      </div>
    </header>

    <main class="max-w-4xl mx-auto px-6 py-16 space-y-16">
      
      <section class="space-y-4">
        <span class="inline-block px-3 py-1 text-xs font-semibold uppercase tracking-wider text-[#FFC72A] bg-[#5F259F]/30 border border-[#FFC72A]/40 rounded-full">
          Volunteer Income Tax Assistance
        </span>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight">
          Free Tax Preparation for the Hunter Community
        </h1>
        <p class="text-lg text-neutral-300 max-w-2xl leading-relaxed">
          The IRS Volunteer Income Tax Assistance (VITA) program at Hunter College provides free federal and state tax preparation to eligible students, staff, and local community members.
        </p>
      </section>

      <section class="grid sm:grid-cols-2 gap-6">
        <div class="p-8 rounded-3xl bg-[#190e2b]/70 border border-[#5F259F]/40 flex flex-col justify-between space-y-6 hover:border-[#FFC72A]/50 transition">
          <div class="space-y-3">
            <span class="text-xs font-bold uppercase tracking-wider text-[#FFC72A]">For Students</span>
            <h2 class="text-2xl font-bold text-white">Become a Volunteer</h2>
            <p class="text-sm text-neutral-300 leading-relaxed">
              Gain hands-on tax experience, earn official IRS preparer certification, and build valuable professional credentials for accounting recruiting.
            </p>
          </div>
          <a href="/vita/volunteer" class="inline-flex items-center justify-center px-5 py-3 rounded-xl bg-[#5F259F] hover:bg-[#722ebd] text-white font-bold text-sm transition">
            Volunteer Details & Training →
          </a>
        </div>

        <div class="p-8 rounded-3xl bg-[#190e2b]/70 border border-[#5F259F]/40 flex flex-col justify-between space-y-6 hover:border-[#FFC72A]/50 transition">
          <div class="space-y-3">
            <span class="text-xs font-bold uppercase tracking-wider text-[#FFC72A]">For Taxpayers</span>
            <h2 class="text-2xl font-bold text-white">Get Your Taxes Done</h2>
            <p class="text-sm text-neutral-300 leading-relaxed">
              Review income eligibility guidelines, download the document checklist, and reserve your in-person or virtual tax preparation appointment.
            </p>
          </div>
          <a href="/vita/client-tax" class="inline-flex items-center justify-center px-5 py-3 rounded-xl bg-[#FFC72A] text-neutral-950 hover:bg-[#e6b224] font-bold text-sm transition shadow-lg shadow-[#FFC72A]/10">
            Appointment & Eligibility →
          </a>
        </div>
      </section>

      <section class="p-8 rounded-3xl bg-gradient-to-r from-[#190e2b] to-[#25123d] border border-[#5F259F]/30">
        <h3 class="text-lg font-bold text-white mb-6">Our Annual Impact</h3>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 text-center">
          <div>
            <div class="text-3xl font-extrabold text-[#FFC72A]">500+</div>
            <div class="text-xs text-neutral-300 mt-1 uppercase font-medium">Returns Filed</div>
          </div>
          <div>
            <div class="text-3xl font-extrabold text-[#FFC72A]">$650K+</div>
            <div class="text-xs text-neutral-300 mt-1 uppercase font-medium">Refunds Secured</div>
          </div>
          <div>
            <div class="text-3xl font-extrabold text-[#FFC72A]">40+</div>
            <div class="text-xs text-neutral-300 mt-1 uppercase font-medium">IRS Preparers</div>
          </div>
          <div>
            <div class="text-3xl font-extrabold text-[#FFC72A]">100%</div>
            <div class="text-xs text-neutral-300 mt-1 uppercase font-medium">Free Service</div>
          </div>
        </div>
      </section>

    </main>
  </body>
</html>
