---
// src/pages/vita/eboard.astro
import '../../styles/global.css';

const vitaOfficers = [
  {
    name: "Officer Name",
    role: "VITA Manager",
    photo: "/officers/placeholder.jpg",
    linkedin: "https://www.linkedin.com/"
  },
  {
    name: "Officer Name",
    role: "VITA Assistant Manager",
    photo: "/officers/placeholder.jpg",
    linkedin: "https://www.linkedin.com/"
  },
  {
    name: "Officer Name",
    role: "VITA Assistant Manager",
    photo: "/officers/placeholder.jpg",
    linkedin: "https://www.linkedin.com/"
  },
  {
    name: "Officer Name",
    role: "Site Coordinator",
    photo: "/officers/placeholder.jpg",
    linkedin: "https://www.linkedin.com/"
  },
  {
    name: "Officer Name",
    role: "Quality Review Lead",
    photo: "/officers/placeholder.jpg",
    linkedin: "https://www.linkedin.com/"
  },
  {
    name: "Officer Name",
    role: "Tax Preparer Lead",
    photo: "/officers/placeholder.jpg",
    linkedin: "https://www.linkedin.com/"
  },
  {
    name: "Officer Name",
    role: "Intake Coordinator",
    photo: "/officers/placeholder.jpg",
    linkedin: "https://www.linkedin.com/"
  },
  {
    name: "Officer Name",
    role: "VITA Intern",
    photo: "/officers/placeholder.jpg",
    linkedin: "https://www.linkedin.com/"
  }
];
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>VITA E-Board | Hunter College Accounting Society</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-[#0e0716] text-neutral-100 min-h-screen font-sans antialiased selection:bg-[#FFC72A] selection:text-neutral-950 flex flex-col justify-between">

    <!-- Top Sticky Navigation Header -->
    <header class="border-b border-[#5F259F]/30 bg-[#0e0716]/95 sticky top-0 z-50 backdrop-blur-md px-6 py-4">
      <div class="max-w-6xl mx-auto flex items-center justify-between">
        <a href="/" class="text-sm font-bold text-white hover:text-[#FFC72A] transition flex items-center gap-2">
          <span>← Back to Home</span>
        </a>
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#FFC72A]"></span>
          <span class="text-xs sm:text-sm uppercase tracking-wider text-[#FFC72A] font-bold">
            VITA Leadership
          </span>
        </div>
      </div>
    </header>

    <!-- Main Content Container -->
    <main class="max-w-6xl mx-auto px-6 py-12 space-y-12 w-full flex-1">
      
      <!-- Executive Board Section -->
      <section id="vita-officers" class="space-y-6">
        <div class="flex items-center justify-between border-b border-[#5F259F]/30 pb-3">
          <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-white">VITA Executive Board</h1>
          <span class="text-xs text-neutral-400">2026 – 2027 Officers</span>
        </div>

        <!-- 4-Column Responsive Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3.5 sm:gap-4">
          {vitaOfficers.map((officer) => (
            <div class="p-5 rounded-2xl bg-[#190e2b]/60 border border-[#5F259F]/30 hover:border-[#FFC72A]/50 transition flex flex-col items-center text-center relative group">
              
              <!-- LinkedIn Link Icon -->
              {officer.linkedin && (
                <a 
                  href={officer.linkedin} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="absolute top-3 right-3 text-neutral-400 hover:text-[#FFC72A] transition"
                  title={`${officer.name}'s LinkedIn`}
                >
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                    <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45a1.63 1.63 0 1 0 0 3.26 1.63 1.63 0 0 0 0-3.26Z" />
                  </svg>
                </a>
              )}

              <!-- Circular Avatar -->
              <img 
                src={officer.photo} 
                alt={officer.name} 
                class="w-16 h-16 rounded-full object-cover border-2 border-[#5F259F] mb-3 bg-[#281344] group-hover:border-[#FFC72A] transition"
                onerror="this.src='https://via.placeholder.com/150'"
              />

              <!-- Name & Role -->
              <h3 class="font-bold text-sm text-white group-hover:text-[#FFC72A] transition leading-snug">
                {officer.name}
              </h3>
              <span class="text-[11px] font-medium text-[#FFC72A] tracking-wide mt-1">
                {officer.role}
              </span>
            </div>
          ))}
        </div>
      </section>

      <!-- Bottom Inquiries Section -->
      <section class="p-6 rounded-2xl bg-[#190e2b]/50 border border-[#5F259F]/30 text-center space-y-2">
        <p class="text-xs sm:text-sm text-neutral-300">
          Interested in joining the leadership team or volunteering with VITA? Email 
          <a href="mailto:huntercollegevita@gmail.com" class="text-[#FFC72A] font-semibold hover:underline ml-1">
            huntercollegevita@gmail.com
          </a>
        </p>
      </section>

    </main>

    <!-- Footer -->
    <footer class="border-t border-[#5F259F]/20 py-8 px-6 text-center text-xs text-neutral-400 mt-12">
      <p>© {new Date().getFullYear()} Hunter College Accounting Society • VITA Leadership</p>
    </footer>

  </body>
</html>
